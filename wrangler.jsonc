{
  // Cloudflare Worker for Bacteria Race 3D:
  // the shared time table (KV) and the online race rooms (Durable Objects).
  "name": "bacteria-race",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "kv_namespaces": [
    { "binding": "SCORES", "id": "b55c074c8c6c4754bab78c05f1cf4570" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "observability": { "enabled": true }
}
